@model HomeDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@functions {
    private static string FormatFollowUpDate(DateTime date)
    {
        var daysUntil = (date.Date - DateTime.Today).Days;

        return daysUntil switch
        {
            0 => "Today",
            1 => "Tomorrow",
            > 1 and < 7 => $"In {daysUntil} days",
            _ => date.ToString("MMM d")
        };
    }

    private static string FormatApplicationDate(DateTime date)
    {
        var daysAgo = (DateTime.Today - date.Date).Days;

        return daysAgo switch
        {
            0 => "Today",
            1 => "Yesterday",
            > 1 and < 30 => $"{daysAgo} days ago",
            _ => date.ToString("MMM d")
        };
    }
}

<div class="dashboard-page">
    <header class="dashboard-header">
        <div>
            <h1>Dashboard</h1>

            <p>
                Overview of your current job search
            </p>
        </div>

        <div class="dashboard-actions">
            <a asp-controller="Applications"
               asp-action="Index"
               class="btn btn-outline-secondary">
                View Applications
            </a>

            <a asp-controller="Applications"
               asp-action="Create"
               class="btn btn-success">
                Add Application
            </a>
        </div>
    </header>

    @if (Model.TotalApplications == 0)
    {
        <section class="dashboard-panel dashboard-empty">
            <h2>No applications yet</h2>

            <p>
                Add your first application to begin tracking your progress.
            </p>

            <a asp-controller="Applications"
               asp-action="Create"
               class="btn btn-success">
                Add Application
            </a>
        </section>
    }
    else
    {
        <section class="dashboard-stats"
                 aria-label="Application statistics">
            <article class="dashboard-stat">
                <span class="dashboard-stat-label">
                    Applications
                </span>

                <strong>@Model.TotalApplications</strong>
            </article>

            <article class="dashboard-stat">
                <span class="dashboard-stat-label">
                    Interview Rate
                </span>

                <strong>
                    @($"{Model.InterviewOrBetterRate:0.#}%")
                </strong>
            </article>

            <article class="dashboard-stat">
                <span class="dashboard-stat-label">
                    Offer Rate
                </span>

                <strong>
                    @($"{Model.OfferRate:0.#}%")
                </strong>
            </article>

            <article class="dashboard-stat">
                <span class="dashboard-stat-label">
                    Accepted
                </span>

                <strong>@Model.AcceptedApplications</strong>
            </article>
        </section>

        <div class="dashboard-content-grid">
            <section class="dashboard-panel dashboard-progress">
                <h2>Application Progress</h2>

                <div class="funnel-chart">
                    <div class="funnel-stage">
                        <div class="funnel-label">
                            Applications
                        </div>

                        <div class="funnel-track">
                            <div class="funnel-fill funnel-total"
                                 style="width: 100%;">
                            </div>
                        </div>

                        <div class="funnel-value">
                            @Model.TotalApplications
                            <span>100%</span>
                        </div>
                    </div>

                    <div class="funnel-stage">
                        <div class="funnel-label">
                            Advanced Past Application
                        </div>

                        <div class="funnel-track">
                            <div class="funnel-fill funnel-advanced"
                                 style="width: @($"{Model.AdvancementRate:0.##}%");">
                            </div>
                        </div>

                        <div class="funnel-value">
                            @Model.AdvancedApplications

                            <span>
                                @($"{Model.AdvancementRate:0.#}%")
                            </span>
                        </div>
                    </div>

                    <div class="funnel-stage">
                        <div class="funnel-label">
                            Interview or Better
                        </div>

                        <div class="funnel-track">
                            <div class="funnel-fill funnel-interview"
                                 style="width: @($"{Model.InterviewOrBetterRate:0.##}%");">
                            </div>
                        </div>

                        <div class="funnel-value">
                            @Model.InterviewOrBetterApplications

                            <span>
                                @($"{Model.InterviewOrBetterRate:0.#}%")
                            </span>
                        </div>
                    </div>

                    <div class="funnel-stage">
                        <div class="funnel-label">
                            Offers
                        </div>

                        <div class="funnel-track">
                            <div class="funnel-fill funnel-offer"
                                 style="width: @($"{Model.OfferRate:0.##}%");">
                            </div>
                        </div>

                        <div class="funnel-value">
                            @Model.OfferApplications

                            <span>
                                @($"{Model.OfferRate:0.#}%")
                            </span>
                        </div>
                    </div>

                    <div class="funnel-stage">
                        <div class="funnel-label">
                            Accepted
                        </div>

                        <div class="funnel-track">
                            <div class="funnel-fill funnel-accepted"
                                 style="width: @($"{Model.AcceptanceRate:0.##}%");">
                            </div>
                        </div>

                        <div class="funnel-value">
                            @Model.AcceptedApplications

                            <span>
                                @($"{Model.AcceptanceRate:0.#}%")
                            </span>
                        </div>
                    </div>
                </div>

                @{
                    var applicationLabel =
                        Model.MultipleInterviewApplications == 1
                            ? "application"
                            : "applications";
                }

                <p class="dashboard-progress-note">
                    @Model.MultipleInterviewApplications @applicationLabel
                    reached at least two interview rounds.
                </p>
            </section>

            <aside class="dashboard-side-column">
                <section class="dashboard-panel">
                    <h2>Upcoming Follow-Ups</h2>

                    @if (Model.UpcomingFollowUps.Any())
                    {
                        <div class="dashboard-list">
                            @foreach (var application in
                                      Model.UpcomingFollowUps)
                            {
                                <a asp-controller="Applications"
                                   asp-action="Edit"
                                   asp-route-id="@application.Id"
                                   class="dashboard-list-item">
                                    <span>
                                        <strong>
                                            @application.Company
                                        </strong>

                                        <small>
                                            @application.Position
                                        </small>
                                    </span>

                                    <time>
                                        @FormatFollowUpDate(
                                            application.FollowUpDate!.Value)
                                    </time>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="dashboard-list-empty">
                            No upcoming follow-ups.
                        </p>
                    }
                </section>

                <section class="dashboard-panel">
                    <h2>Recent Applications</h2>

                    @if (Model.RecentApplications.Any())
                    {
                        <div class="dashboard-list">
                            @foreach (var application in
                                      Model.RecentApplications)
                            {
                                <a asp-controller="Applications"
                                   asp-action="Edit"
                                   asp-route-id="@application.Id"
                                   class="dashboard-list-item">
                                    <span>
                                        <strong>
                                            @application.Company
                                        </strong>

                                        <small>
                                            @application.Position
                                        </small>
                                    </span>

                                    <time>
                                        @FormatApplicationDate(
                                            application.ApplicationDate)
                                    </time>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="dashboard-list-empty">
                            No recent applications.
                        </p>
                    }
                </section>
            </aside>
        </div>
    }
</div>