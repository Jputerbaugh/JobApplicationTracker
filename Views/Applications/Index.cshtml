@model IEnumerable<JobApplication>

@{
    ViewData["Title"] = "Applications";
}

<h1>Job Applications</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Add New Application</a>

@if (!Model.Any()) {
    <p>
        No job applications have been added yet
    </p>
}
else {
    <table class = "table table-striped">
        <thead>
            <tr>
                <th>Company</th>
                <th>Position</th>
                <th>Location</th>
                <th>Status</th>
                <th>Application Date</th>
                <th>URL</th>
                <th>Follow Up</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var application in Model) 
            {
                <tr>
                    <td>@application.Company</td>
                    <td>@application.Position</td>
                    <td>@application.Location</td>
                    <td>@application.Status</td>
                    <td>@application.ApplicationDate.ToShortDateString()</td>
                    <td>@application.JobURL</td>
                    <td>@application.FollowUpDate?.ToShortDateString()</td>
                    <td>@application.Notes</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@application.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@application.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}