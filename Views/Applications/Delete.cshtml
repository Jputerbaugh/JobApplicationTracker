@model JobApplication

@{
    ViewData["Title"] = "Delete Application";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="fw-bold text-danger mb-1">Delete Application</h1>

            <p class="text-muted mb-0">
                Review the application before permanently deleting it.
            </p>
        </div>

        <div class="alert alert-danger" role="alert">
            <strong>Are you sure?</strong>
            This action cannot be undone.
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h4 mb-4">
                    @Model.Company — @Model.Position
                </h2>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Company</dt>
                    <dd class="col-sm-8">@Model.Company</dd>

                    <dt class="col-sm-4">Position</dt>
                    <dd class="col-sm-8">@Model.Position</dd>

                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(Model.Location))
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            @Model.Location
                        }
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>

                    <dt class="col-sm-4">Application Date</dt>
                    <dd class="col-sm-8">
                        @Model.ApplicationDate.ToShortDateString()
                    </dd>

                    <dt class="col-sm-4">Follow-Up Date</dt>
                    <dd class="col-sm-8">
                        @if (Model.FollowUpDate.HasValue)
                        {
                            @Model.FollowUpDate.Value.ToShortDateString()
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Job Posting</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.JobURL))
                        {
                            <a href="@Model.JobURL"
                               target="_blank"
                               rel="noopener noreferrer">
                                View Posting
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            @Model.Notes
                        }
                    </dd>
                </dl>

                <hr class="my-4" />

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            Permanently Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>