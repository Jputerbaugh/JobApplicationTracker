@model JobApplication

@{
    ViewData["Title"] = "Delete Application";
}

<div class="form-page delete-page">
    <header class="page-header delete-page-header">
        <div>
            <h1 class="delete-page-title">Delete Application</h1>

            <p>
                Review the application before permanently deleting it.
            </p>
        </div>
    </header>

    <div class="alert alert-danger delete-warning" role="alert">
        <strong>Are you sure?</strong>
        This action cannot be undone.
    </div>

    <div class="card delete-panel">
        <div class="card-body application-form-body">
            <h2 class="h4 mb-4">
                @Model.Company — @Model.Position
            </h2>

            <dl class="delete-details">
                <dt>Company</dt>
                <dd>@Model.Company</dd>

                <dt>Position</dt>
                <dd>@Model.Position</dd>

                <dt>Location</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(Model.Location))
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        @Model.Location
                    }
                </dd>

                <dt>Furthest Stage Reached</dt>
                <dd>
                    @Html.DisplayFor(model => model.Stage)
                </dd>

                <dt>Interview Round Reached</dt>
                <dd>
                    @if (Model.FurthestInterviewRound == InterviewRound.None)
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        @Html.DisplayFor(model => model.FurthestInterviewRound)
                    }
                </dd>

                <dt>Outcome</dt>
                <dd>
                    @Html.DisplayFor(model => model.Outcome)
                </dd>

                <dt>Application Date</dt>
                <dd>
                    @Model.ApplicationDate.ToString("MMM d, yyyy")
                </dd>

                <dt>Follow-Up Date</dt>
                <dd>
                    @if (Model.FollowUpDate.HasValue)
                    {
                        @Model.FollowUpDate.Value.ToString("MMM d, yyyy")
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>

                <dt>Job Posting</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(Model.JobURL))
                    {
                        <a href="@Model.JobURL"
                            target="_blank"
                            rel="noopener noreferrer">
                            View Posting
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>

                <dt>Notes</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        @Model.Notes
                    }
                </dd>
            </dl>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">
                        Permanently Delete
                    </button>

                    <a asp-action="Index"
                        class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
