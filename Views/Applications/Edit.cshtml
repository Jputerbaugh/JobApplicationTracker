@model JobApplication

@{
    ViewData["Title"] = "Edit Application";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="fw-bold mb-1">Edit Application</h1>

            <p class="text-muted mb-0">
                Update the information or progress for this opportunity.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Company" class="form-label"></label>
                            <input asp-for="Company" class="form-control" />
                            <span asp-validation-for="Company"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Position" class="form-label"></label>
                            <input asp-for="Position" class="form-control" />
                            <span asp-validation-for="Position"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label"></label>

                            <select asp-for="Stage"
                                    asp-items="Html.GetEnumSelectList<ApplicationStage>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Stage"
                                class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FurthestInterviewRound"
                                class="form-label"></label>

                            <select asp-for="FurthestInterviewRound"
                                    asp-items="Html.GetEnumSelectList<InterviewRound>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="FurthestInterviewRound"
                                class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Outcome" class="form-label"></label>

                            <select asp-for="Outcome"
                                    asp-items="Html.GetEnumSelectList<ApplicationOutcome>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Outcome"
                                class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ApplicationDate"
                                   class="form-label"></label>

                            <input asp-for="ApplicationDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="ApplicationDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate"
                                   class="form-label"></label>

                            <input asp-for="FollowUpDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="FollowUpDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="JobURL" class="form-label"></label>

                            <input asp-for="JobURL"
                                   type="url"
                                   class="form-control" />

                            <span asp-validation-for="JobURL"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}